# Copy to .env and adjust. All optional.
HTTP_PORT=8080            # the one port browsers use (app, data and the game server via /api)
DATA_PATH=./data          # extracted game data; originals go in ./game-files and are never modified
MAX_PLAYERS=2
SNAPSHOT_RATE=20          # state snapshots per second sent to each client (simulation always runs at 60 Hz)
RECONNECT_SECONDS=60      # how long a dropped player's seat is kept
ENABLE_SONIC3=0           # 1 offers the experimental Sonic 3 mode in the lobby (not playable with its original logic)
ENABLE_DEV_TOOLS=0        # 1 enables level select, overlays and restart commands for everyone in a room
APP_VERSION=dev           # shown by /api/health and /version.txt
