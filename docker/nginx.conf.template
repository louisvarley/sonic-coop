# Generated from /etc/nginx/templates at container start (envsubst): ${SERVER_UPSTREAM}

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  location = /manifest.webmanifest {
    default_type application/manifest+json;
    types { }
  }

  gzip on;
  gzip_types text/css application/javascript application/json application/octet-stream image/svg+xml;
  gzip_min_length 1024;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Game server (Colyseus matchmaking over HTTP and the room WebSockets).
  location /api/ {
    proxy_pass http://${SERVER_UPSTREAM}/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Extracted game data (read-only volume, never baked into the image).
  location /data/ {
    alias /data/;
    add_header Cache-Control "public, max-age=3600";
    location ~ \.json$ { add_header Cache-Control "no-cache"; }
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
